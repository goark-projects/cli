# Goark CLI 项目构建描述文件
version = 1

[project]
name = "goark-cli"
main = "./cmd/goark"
description = "Goark 命令行工具"

[execution]
max-parallel = 4
fail-fast = true
default-timeout = "5m"

[generate]
patterns = ["./..."]
clean-stale = true

[commands.run]
before = []
after = []
finally = []
go-args = []
application-args = []

[commands.build]
before = []
after = []
finally = []
go-args = ["-trimpath"]
output = "./build/goark"

[commands.test]
before = []
after = []
finally = []
go-args = ["-count=1", "./..."]
